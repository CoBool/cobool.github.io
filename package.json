{
  "name": "next-markdown-vcard-blog",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.9.0",
  "scripts": {
    "dev": "next dev",
    "build": "node scripts/build.mjs",
    "postbuild": "pagefind --site out --silent && node scripts/check-export.mjs",
    "typecheck": "tsc --noEmit",
